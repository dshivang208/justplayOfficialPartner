# Copy this file to .env.local (git-ignored) and fill in your real project values.
# This is the SAME Supabase project the consumer JustPlay app uses — find
# both values in that project: Settings -> API.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Firebase Cloud Messaging (web push) ─────────────────────────────────────
# Firebase console -> Project settings -> General -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase console -> Project settings -> Cloud Messaging -> Web Push certificates
# -> "Generate key pair" (this is FCM's own key; no web-push/VAPID library needed).
VITE_FIREBASE_VAPID_KEY=

# ── QR codes ────────────────────────────────────────────────────────────────
# Public address of the CONSUMER website (no trailing slash). QR codes point to <this>/q and <this>/q/<venue code>.
VITE_CONSUMER_URL=
